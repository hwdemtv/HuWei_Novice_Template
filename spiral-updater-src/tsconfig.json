{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "outDir": "./dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "noImplicitAny": true
  },
  "include": ["src/**/*.ts"]
}
